# chess-64-squares-backend — copy to .env in THIS folder.
NODE_ENV=development
BACKEND_PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# PostgreSQL (docker-compose.yml in this folder starts it; host port is
# POSTGRES_PORT — use 5433 if a native Postgres already owns 5432)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=chess64
POSTGRES_PASSWORD=chess64_dev_password
POSTGRES_DB=chess64
# Optional read replicas "host:port,host:port" (see ARCHITECTURE.md §2.6)
POSTGRES_REPLICA_HOSTS=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth — generate real secrets outside dev: openssl rand -hex 64
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000

# Gameplay
DISCONNECT_GRACE_SEC=60

# Email (verification links). Empty SMTP_HOST = links print to the log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS="chess-64-squares <no-reply@example.com>"
FRONTEND_BASE_URL=http://localhost:5173
EMAIL_VERIFICATION_TTL_HOURS=24
